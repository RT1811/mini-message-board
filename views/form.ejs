<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <form method="POST" action="/new">
        <label for="user">Name:</label>
        <input type="text" id="user" name="user" required>

        <label for="text">Message:</label>
        <input type="text" id="text" name="text" required>

        <button type="submit">Submit</button>
    </form>
</body>
</html>